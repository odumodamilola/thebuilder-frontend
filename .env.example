# Local development; no secrets belong in NEXT_PUBLIC variables.
BUILDER_BUILD_TARGET=preview
# Generate a private random value of at least 32 characters, identical in the API.
BUILDER_SSR_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="The Builder"
NEXT_PUBLIC_DESIGN_PREVIEW=false
NEXT_PUBLIC_EVENTS_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SESSION_COOKIE_NAME=the_builder_session
