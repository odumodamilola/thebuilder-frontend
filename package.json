{
  "name": "the-builder-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^22.0.0 || ^24.0.0" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/seal-build.cjs",
    "start": "next start",
    "lint": "eslint pages src proxy.ts",
    "type-check": "tsc --noEmit",
    "check:theme": "node scripts/check-color-tokens.cjs && node scripts/check-public-theme.cjs",
    "lint:fix": "eslint pages src --fix",
    "build:turbopack": "next build && node scripts/seal-build.cjs",
    "format:check": "prettier --check pages src proxy.ts next.config.ts",
    "check:contract": "node scripts/check-api-contract.cjs",
    "check:settings": "node scripts/check-site-settings.cjs",
    "check:auth": "node scripts/check-auth-navigation.cjs",
    "check:editorial": "node scripts/check-editorial-policy.cjs && node scripts/check-cookie-consent.cjs",
    "check:release": "node scripts/check-release-regressions.cjs",
    "release:preflight": "node scripts/release-environment.cjs",
    "check:tooling-risk": "node scripts/check-tooling-risk.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/montserrat": "^5.1.1",
    "@fontsource/source-serif-4": "^5.1.1",
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.511.0",
    "next": "16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
