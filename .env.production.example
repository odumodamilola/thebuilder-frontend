# Proposed API subdomain; verify DNS, TLS and hosting before building a release.
BUILDER_BUILD_TARGET=release
# Server-only: identical private random value in Laravel; never NEXT_PUBLIC.
BUILDER_SSR_SECRET=
NEXT_PUBLIC_APP_URL=https://thebuilderng.com
NEXT_PUBLIC_API_URL=https://api.thebuilderng.com/api/v1
NEXT_PUBLIC_APP_NAME="The Builder"
NEXT_PUBLIC_DESIGN_PREVIEW=false
NEXT_PUBLIC_EVENTS_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SESSION_COOKIE_NAME=the_builder_session
